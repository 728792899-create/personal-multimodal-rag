# The app runs locally with mock + memory by default.
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=hash-mock
EMBEDDING_DIMENSION=256
OPENAI_API_KEY=
OPENAI_BASE_URL=

# memory | chroma | pgvector
VECTOR_STORE=memory
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=personal_knowledge
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/personal_rag
PGVECTOR_TABLE=rag_chunks

# keyword | none
RERANKER=keyword
RERANKER_MODEL=BAAI/bge-reranker-base
INITIAL_RETRIEVAL_K=24
BM25_WEIGHT=0.62
VECTOR_WEIGHT=0.38
NO_ANSWER_THRESHOLD=0.05
GROUNDING_MIN_CONFIDENCE=0.15
CITATION_OVERLAP_THRESHOLD=0.34
MMR_LAMBDA=0.78

# template | responses
ANSWER_PROVIDER=template
ANSWER_MODEL=gpt-5.5
ANSWER_BASE_URL=
ANSWER_API_KEY=
ANSWER_TIMEOUT_SECONDS=45

# none | responses
QUERY_REWRITE_PROVIDER=none
QUERY_REWRITE_MODEL=gpt-5.5
QUERY_REWRITE_BASE_URL=
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_COUNT=2

DOCUMENT_REGISTRY_PATH=./data/registry.sqlite3
MAX_UPLOAD_BYTES=20971520
# Keep disabled unless URL import must intentionally access a trusted private network.
RAG_ALLOW_PRIVATE_URLS=0

# Optional image OCR runtime:
# brew install tesseract
# python3 -m pip install pytesseract

# Real Chroma + OpenAI embedding demo:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
