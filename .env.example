# The app runs locally with mock + memory + template by default.
APP_ENVIRONMENT=local
PROVIDER_FALLBACK_ALLOWED=1
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=hash-mock
EMBEDDING_DIMENSION=256
OPENAI_API_KEY=
OPENAI_BASE_URL=

# memory | chroma | pgvector
VECTOR_STORE=memory
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=personal_knowledge
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/personal_rag
PGVECTOR_TABLE=rag_chunks

# keyword | none
RERANKER=keyword
RERANKER_MODEL=BAAI/bge-reranker-base
INITIAL_RETRIEVAL_K=24
BM25_WEIGHT=0.62
VECTOR_WEIGHT=0.38
NO_ANSWER_THRESHOLD=0.05
GROUNDING_MIN_CONFIDENCE=0.15
CITATION_OVERLAP_THRESHOLD=0.34
MMR_LAMBDA=0.78

# template | openai_responses | openai_compatible_chat | ollama
ANSWER_PROVIDER=template
ANSWER_MODEL=gpt-5.6
ANSWER_BASE_URL=
ANSWER_API_KEY=
ANSWER_TIMEOUT_SECONDS=45

# none | responses
QUERY_REWRITE_PROVIDER=none
QUERY_REWRITE_MODEL=gpt-5.6
QUERY_REWRITE_BASE_URL=
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_COUNT=2

DOCUMENT_REGISTRY_PATH=./data/registry.sqlite3
OBJECT_STORE_PATH=./data/objects
CHUNKER_VERSION=paragraph-v1
INDEX_VERSION=hybrid-v1
INGESTION_POLL_SECONDS=0.10
INGESTION_LEASE_SECONDS=120
# builtin is the zero-download default. mineru/docling/paddleocr require the
# isolated `advanced-parser` Compose profile.
PARSER_PROVIDER=builtin
PARSER_WORKER_URL=http://parser-worker:8090
PARSER_TIMEOUT_SECONDS=300
PARSER_FALLBACK_ALLOWED=1
MAX_UPLOAD_BYTES=20971520
UPLOAD_PROCESSING_TIMEOUT_SECONDS=90
URL_IMPORT_TIMEOUT_SECONDS=12
URL_IMPORT_MAX_BYTES=2000000
# Keep disabled unless URL import must intentionally access a trusted private network.
RAG_ALLOW_PRIVATE_URLS=0

# Optional single-user/small-team boundary. Set a high-entropy token behind HTTPS.
API_AUTH_TOKEN=
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Optional production error reporting. Install sentry-sdk from requirements-optional.txt first.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.05

# Local Ollama adapter. No browser-side key storage is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional image OCR runtime:
# brew install tesseract
# python3 -m pip install pytesseract

# Real Chroma + OpenAI embedding demo:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# OPENAI_API_KEY=replace-with-your-key
# VECTOR_STORE=chroma
# CHROMA_PATH=./data/chroma-openai-demo
# CHROMA_COLLECTION=personal_knowledge_demo

# For production, set APP_ENVIRONMENT=production and keep
# PROVIDER_FALLBACK_ALLOWED=0 so unavailable external providers fail closed.
