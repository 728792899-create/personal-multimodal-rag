FROM python:3.11.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-chi-sim \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system rag \
    && useradd --system --gid rag --home-dir /app --create-home rag

COPY backend/requirements.txt backend/requirements-local-production.txt /app/backend/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 5 -r /app/backend/requirements-local-production.txt

COPY --chown=rag:rag backend /app/backend
COPY --chown=rag:rag data /app/data

USER rag
WORKDIR /app/backend
EXPOSE 8010
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
