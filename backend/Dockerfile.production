FROM python:3.11.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-chi-sim \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system rag \
    && useradd --system --gid rag --home-dir /app --create-home rag

WORKDIR /app
COPY backend/requirements.txt backend/requirements-optional.txt backend/requirements-production.txt /app/backend/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --timeout 300 --retries 5 -r /app/backend/requirements-production.txt

COPY --chown=rag:rag backend /app/backend
COPY --chown=rag:rag scripts /app/scripts
COPY --chown=rag:rag data /app/data

USER rag
WORKDIR /app/backend
EXPOSE 8010

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8010/ready', timeout=2)" || exit 1

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8010"]
